#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+bindnow

# Use Ninja when it is available
BUILDSYS := cmake
ifneq (,$(shell command -v ninja 2>/dev/null))
BUILDSYS := cmake+ninja
endif

%:
	dh $@ --buildsystem=$(BUILDSYS) --builddirectory=build

override_dh_auto_configure:
	dh_auto_configure -- \
	  -DCMAKE_INSTALL_PREFIX=/usr \
	  -DLIBEASYMCP2221_BUILD_SHARED=ON \
	  -DLIBEASYMCP2221_BUILD_STATIC=ON \
	  -DLIBEASYMCP2221_BUILD_TESTS=ON \
	  -DLIBEASYMCP2221_BUILD_DOCS=ON

override_dh_auto_build:
	dh_auto_build
	cmake --build build --target docs

override_dh_installdocs:
	dh_installdocs -plibeasymcp2221-doc --doc-main-package=libeasymcp2221-doc
	dh_installdocs --remaining-packages

override_dh_missing:
	dh_missing --fail-missing
