Rules-Requires-Root: no

Package: libeasymcp2221-2
Architecture: any
Depends:
 ${shlibs:Depends},
 ${misc:Depends}
Description: EasyMCP2221 C library for Microchip MCP2221 USB-I2C bridge
 This package provides the shared runtime library for applications using
 Microchip MCP2221 and MCP2221A USB-I²C/GPIO bridges. It supports I2C,
 SMBus, GPIO, and device configuration through the libeasymcp2221 C API.

Package: libeasymcp2221-dev
Section: libdevel
Architecture: any
Depends:
 libeasymcp2221-2 (= ${binary:Version}),
 libusb-1.0-0-dev,
 libudev-dev [linux-any],
 ${misc:Depends}
Description: Development files for EasyMCP2221 C library
 This package provides the C headers, static library, pkg-config metadata,
 and development symlink needed to build applications with libeasymcp2221.
 It also installs the dependencies required by downstream C consumers.

Package: libeasymcp2221-doc
Architecture: all
Section: doc
Depends:
 ${misc:Depends}
Description: API documentation for EasyMCP2221 C library
 This package provides the generated Doxygen HTML API reference and supporting
 documentation for libeasymcp2221.